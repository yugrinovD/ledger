# application
LEDGER_ENV=dev
LEDGER_SERVICE_NAME=ledger
LEDGER_LOG_LEVEL=info
LEDGER_HTTP_ADDR=:8080
LEDGER_ADMIN_ADDR=:9090

# postgres
LEDGER_DATABASE_URL=postgres://ledger:ledger@localhost:5432/ledger?sslmode=disable
LEDGER_DB_MAX_CONNS=20
LEDGER_DB_MIN_CONNS=2
LEDGER_DB_MAX_CONN_LIFETIME=1h
LEDGER_DB_MAX_CONN_IDLE=15m
LEDGER_DB_CONNECT_TIMEOUT=5s

# redis (rate limiting; failures are fail-open)
LEDGER_REDIS_ADDR=localhost:6379
LEDGER_REDIS_PASSWORD=
LEDGER_REDIS_DB=0
LEDGER_RATE_LIMIT_RPM=100000
LEDGER_PREAUTH_RATE_LIMIT_RPM=600000
LEDGER_TRUSTED_PROXIES=

# api auth; production requires non-default values of at least 32 chars
LEDGER_AUTH_PEPPER=dev-pepper-change-me
LEDGER_ADMIN_TOKEN=dev-admin-token-change-me

# kafka / redpanda
LEDGER_KAFKA_BROKERS=localhost:19092
LEDGER_KAFKA_TOPIC=ledger.events.v1
LEDGER_KAFKA_DLQ_TOPIC=ledger.events.v1.dlq
LEDGER_KAFKA_CONSUMER_GROUP=ledger-projection
LEDGER_KAFKA_CLIENT_ID=ledger

# outbox / background jobs
LEDGER_OUTBOX_BATCH_SIZE=1000
LEDGER_OUTBOX_POLL_INTERVAL=100ms
LEDGER_OUTBOX_MAX_ATTEMPTS=20
LEDGER_RECONCILIATION_INTERVAL=15m
LEDGER_RECONCILIATION_STATEMENT_TIMEOUT=5m
LEDGER_OUTBOX_RETENTION=168h
LEDGER_PROCESSED_EVENTS_RETENTION=720h
LEDGER_AUDIT_RETENTION=720h
LEDGER_RECONCILIATION_RETENTION=720h
LEDGER_HOLD_SWEEP_INTERVAL=1m
LEDGER_IDEMPOTENCY_TTL=24h

# observability
LEDGER_OTLP_ENDPOINT=
LEDGER_TRACE_RATIO=1
LEDGER_PROFILING=false

# http server
LEDGER_SHUTDOWN_TIMEOUT=15s
LEDGER_READ_HEADER_TIMEOUT=5s
LEDGER_REQUEST_TIMEOUT=10s

# Docker Compose host ports (set these in .env if defaults are busy)
LEDGER_API_PORT=8080
LEDGER_API_ADMIN_PORT=9090
LEDGER_WORKER_ADMIN_PORT=9091
LEDGER_DB_PORT=5432
LEDGER_REDIS_PORT=6379
LEDGER_KAFKA_PORT=19092
LEDGER_KAFKA_UI_PORT=8082
LEDGER_PROMETHEUS_PORT=9095
LEDGER_GRAFANA_PORT=3000
LEDGER_JAEGER_UI_PORT=16686
LEDGER_OTLP_PORT=4317
LEDGER_OTLP_HTTP_PORT=4318
LEDGER_API_URL=http://localhost:8080
LEDGER_ADMIN_URL=http://localhost:9090
